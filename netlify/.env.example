# MT옵틱스 v1.5 로컬/개발 환경설정 예시
# 실제 비밀번호가 들어간 .env 파일은 GitHub에 올리지 마세요.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=32자_이상의_새로운_무작위_문자열로_변경
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*
TRUST_PROXY=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mtopt
DB_PASSWORD=여기에_DB_비밀번호_입력
DB_NAME=mt_optics
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_AUTO_CREATE_DATABASE=false
AUTO_MIGRATE=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=10자_이상의_새로운_관리자_비밀번호
ADMIN_FULL_NAME=시스템관리자
ADMIN_EMAIL=admin@mtoptics.local

SEED_SAMPLE_DATA=false
ALLOW_REMOTE_SHUTDOWN=false
SECURITY_STRICT_MODE=false
LOGIN_RATE_LIMIT_PER_15M=20
API_RATE_LIMIT_PER_15M=1200
MAX_EXCEL_FILE_MB=20
