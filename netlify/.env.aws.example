# AWS RDS 접속 예시. 현재 Lightsail 단일 서버 구성에는 사용하지 않아도 됩니다.
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
JWT_SECRET=32자_이상의_새로운_무작위_문자열로_변경
JWT_EXPIRES_IN=8h
CORS_ORIGIN=https://order.mtoptics.net
TRUST_PROXY=1

DB_HOST=여기에_RDS_ENDPOINT
DB_PORT=3306
DB_USER=mtopt
DB_PASSWORD=여기에_RDS_비밀번호
DB_NAME=mt_optics
DB_CONNECTION_LIMIT=10
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_AUTO_CREATE_DATABASE=false
AUTO_MIGRATE=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=10자_이상의_새로운_관리자_비밀번호
ADMIN_FULL_NAME=시스템관리자
ADMIN_EMAIL=admin@mtoptics.local
SEED_SAMPLE_DATA=false
ALLOW_REMOTE_SHUTDOWN=false
SECURITY_STRICT_MODE=true
