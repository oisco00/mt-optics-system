# AWS RDS 접속용 .env 예시
# 1) 이 파일을 .env 로 복사합니다.
# 2) DB_PASSWORD, ADMIN_PASSWORD, JWT_SECRET은 실제 값으로 바꿉니다.
# 3) .env는 절대 GitHub에 올리지 마세요.

PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-long-random-secret
CORS_ORIGIN=*

DB_HOST=mtoptics.cls0gww4u9u4.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=mtopt
DB_PASSWORD=여기에_mtopt_비밀번호_입력
DB_NAME=mt_optics
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_AUTO_CREATE_DATABASE=false
AUTO_MIGRATE=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=운영_관리자_비밀번호로_변경
ADMIN_FULL_NAME=시스템관리자
ADMIN_EMAIL=admin@mtoptics.local
SEED_SAMPLE_DATA=false
