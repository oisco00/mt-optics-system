# AWS Lightsail 단일 서버(Node.js + MySQL) 운영 예시
# 이 파일을 서버에서 .env로 복사한 뒤 반드시 비밀번호와 도메인을 수정하세요.

PORT=3000
HOST=127.0.0.1
NODE_ENV=production
JWT_SECRET=32자_이상의_새로운_무작위_문자열로_변경
JWT_EXPIRES_IN=8h
CORS_ORIGIN=https://order.mtoptics.net
TRUST_PROXY=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mtopt
DB_PASSWORD=여기에_Lightsail_MySQL_비밀번호_입력
DB_NAME=mt_optics
DB_CONNECTION_LIMIT=10
DB_SSL=false
DB_AUTO_CREATE_DATABASE=false
AUTO_MIGRATE=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=10자_이상의_새로운_관리자_비밀번호
ADMIN_FULL_NAME=시스템관리자
ADMIN_EMAIL=admin@mtoptics.local

SEED_SAMPLE_DATA=false
ALLOW_REMOTE_SHUTDOWN=false
SECURITY_STRICT_MODE=true
LOGIN_RATE_LIMIT_PER_15M=20
API_RATE_LIMIT_PER_15M=1200
MAX_EXCEL_FILE_MB=20
