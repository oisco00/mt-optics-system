# MT옵틱스 v1.4 환경설정 예시
# 주의: 이 파일은 예시입니다. 실제 접속 비밀번호가 들어간 .env 파일은 GitHub에 올리지 마세요.

PORT=3000
NODE_ENV=development
JWT_SECRET=change-this-long-random-secret-please-change
CORS_ORIGIN=*

# MySQL / AWS RDS 접속 정보
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mtopt
DB_PASSWORD=여기에_DB_비밀번호_입력
DB_NAME=mt_optics
DB_CONNECTION_LIMIT=10

# AWS RDS에서 SSL/TLS 접속을 쓰려면 true로 바꾸세요.
# 접속이 안 되면 우선 false로 테스트하고, 운영 전 true 적용을 권장합니다.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# AWS RDS에 DB를 미리 생성했다면 false 권장
# 로컬 PC MySQL에서 root/admin 계정으로 자동 DB 생성까지 할 때만 true
DB_AUTO_CREATE_DATABASE=false
AUTO_MIGRATE=true

# 최초 관리자 계정: users 테이블에 admin이 없을 때 자동 생성됩니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234!
ADMIN_FULL_NAME=시스템관리자
ADMIN_EMAIL=admin@mtoptics.local

SEED_SAMPLE_DATA=false
